{
  "name": "pet-profile-quiz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "predev": "node scripts/generate-kink-catalog.mjs && node scripts/generate-reward-punishment-library.mjs",
    "prebuild": "node scripts/generate-kink-catalog.mjs && node scripts/generate-reward-punishment-library.mjs",
    "pretest": "node scripts/generate-kink-catalog.mjs && node scripts/generate-reward-punishment-library.mjs",
    "test": "vitest run",
    "pretest:e2e": "npm run pretest",
    "test:e2e": "tsc --project tsconfig.e2e.json && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:a11y": "npm run test:e2e -- --grep @a11y",
    "lint": "eslint . --max-warnings=0",
    "lint:workflows": "actionlint",
    "pretest:coverage": "npm run pretest",
    "test:coverage": "vitest run --coverage && node scripts/check-coverage.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "pretest:visual": "npm run pretest",
    "test:visual": "tsc --project tsconfig.e2e.json && playwright test --config=playwright.visual.config.ts",
    "test:smoke": "tsc --project tsconfig.e2e.json && playwright test --config=playwright.deployed.config.ts"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.46.0",
    "html2canvas": "^1.4.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "^4.14.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.71.2",
    "vite": "^7.1.3",
    "vitest": "5.0.5"
  }
}
