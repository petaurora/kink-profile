{
  "name": "pet-profile-quiz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "predev": "node scripts/generate-kink-catalog.mjs && node scripts/generate-reward-punishment-library.mjs",
    "prebuild": "node scripts/generate-kink-catalog.mjs && node scripts/generate-reward-punishment-library.mjs",
    "pretest": "node scripts/generate-kink-catalog.mjs && node scripts/generate-reward-punishment-library.mjs",
    "test": "vitest run",
    "pretest:e2e": "npm run pretest",
    "test:e2e": "tsc --project tsconfig.e2e.json && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:a11y": "npm run test:e2e -- --grep @a11y"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.3",
    "@tabler/icons-react": "^3.46.0",
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
